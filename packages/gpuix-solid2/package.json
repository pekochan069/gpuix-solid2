{
  "name": "gpuix-solid2",
  "version": "0.0.1",
  "private": false,
  "description": "GPUIX native renderer for Solid 2",
  "keywords": [
    "gpui",
    "gpuix",
    "solid",
    "solidjs"
  ],
  "license": "(MIT AND Apache-2.0)",
  "author": {
    "name": "pekochan069",
    "email": "pekochan069@gmail.com",
    "url": "https://github.com/pekochan069/gpuix-solid2.git"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pekochan069/gpuix-solid2.git",
    "directory": "packages/gpuix-solid2"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./automation": {
      "types": "./dist/automation.d.ts",
      "import": "./dist/automation.js",
      "default": "./dist/automation.js"
    },
    "./bun-plugin": {
      "types": "./dist/bun-plugin.d.ts",
      "import": "./dist/bun-plugin.js",
      "default": "./dist/bun-plugin.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js",
      "default": "./dist/preload.js"
    },
    "./button": {
      "types": "./dist/components/button.d.ts",
      "import": "./dist/components/button.js",
      "default": "./dist/components/button.js"
    },
    "./select": {
      "types": "./dist/components/select.d.ts",
      "import": "./dist/components/select.js",
      "default": "./dist/components/select.js"
    },
    "./combobox": {
      "types": "./dist/components/combobox.d.ts",
      "import": "./dist/components/combobox.js",
      "default": "./dist/components/combobox.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog.d.ts",
      "import": "./dist/components/dialog.js",
      "default": "./dist/components/dialog.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/components/tooltip.js",
      "default": "./dist/components/tooltip.js"
    },
    "./floating": {
      "types": "./dist/components/floating.d.ts",
      "import": "./dist/components/floating.js",
      "default": "./dist/components/floating.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "bun run build",
    "check-types": "tsrs --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "build:consumer": "tsdown --config fixtures/consumer/tsdown.config.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@solidjs/compiler": "^2.0.0-rc.17",
    "@solidjs/universal": "^2.0.0-rc.17"
  },
  "devDependencies": {
    "@gpuix/native": "0.11.0",
    "@types/bun": "^1.4.4",
    "solid-js": "^2.0.0-rc.17",
    "tsdown": "^0.23.4",
    "tsrs": "^0.20.1-ts7.1.0-beta",
    "typescript": "^7.1.0-beta"
  },
  "peerDependencies": {
    "@gpuix/native": "0.11.0",
    "solid-js": "^2.0.0-rc.17"
  }
}
