{
  "name": "gpuix-solid2-aria",
  "version": "0.0.1",
  "description": "Native Solid 2 interaction behaviors for GPUIX",
  "license": "(MIT AND Apache-2.0)",
  "files": [
    "dist",
    "LICENSE",
    "LICENSES",
    "NOTICE.txt",
    "README.md",
    "PORTING.md",
    "native-coverage.json",
    "docs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsrs --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "bun test --preload gpuix-solid2/preload test",
    "check:native": "bun run build && bun scripts/check-native.ts",
    "test:native": "bun --preload gpuix-solid2/preload fixtures/native.ts",
    "test:native:checkbox-group": "bun --preload gpuix-solid2/preload fixtures/checkbox-group-native.ts",
    "test:native:toggle-button-group": "bun --preload gpuix-solid2/preload fixtures/toggle-button-group-native.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "gpuix-solid2-stately": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.4"
  },
  "peerDependencies": {
    "@gpuix/native": "0.11.0",
    "gpuix-solid2": "^0.0.1",
    "solid-js": "^2.0.0-rc.17"
  }
}
